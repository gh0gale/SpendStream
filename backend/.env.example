# Copy to backend/.env and fill in. Never commit .env.
# The API refuses to start if a required value is missing (backend/config.py).
# Scripts (train_model.py, cron_runner.py) need only the Supabase values.

# ── Required ──────────────────────────────────────────────────

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth. Register ${BACKEND_URL}/auth/callback as a redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for POST /cron/fetch-all, sent as the X-Cron-Secret header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Fernet key that encrypts stored Gmail refresh tokens. Losing or changing it
# means every user has to reconnect Gmail.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────────────

# The only origin CORS allows, and where the Gmail OAuth callback sends users back.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CRON_MAX_WORKERS=5
# Gmail syncs running at once in this process; more wait their turn (512 MB host).
MAX_CONCURRENT_SYNCS=3

# Host deploy hook (Render: Settings > Deploy Hook). weekly_retrain.py calls it
# after shipping a new model; the restarted backend downloads that model.
# Set it as a GitHub repository secret too; the backend itself never uses it.
DEPLOY_HOOK_URL=
